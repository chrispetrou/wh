# github oauth app (Settings > Developer settings > OAuth Apps)
# callback url must be $APP_URL/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 32+ random chars, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# base url of this app; an https url also turns on secure cookies
APP_URL=http://localhost:3000

# who may sign in: comma-separated github logins, case-insensitive.
# unset means anyone with a github account
# WD_ALLOWED_LOGINS=alice,bob

# github enterprise or a proxy; defaults shown
# GITHUB_API_URL=https://api.github.com
# GITHUB_GRAPHQL_URL=https://api.github.com/graphql

# llm gateways; defaults shown
# WD_ANTHROPIC_URL=https://api.anthropic.com
# WD_OPENAI_URL=https://api.openai.com
# WD_GROQ_URL=https://api.groq.com/openai
